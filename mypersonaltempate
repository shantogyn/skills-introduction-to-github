//gcd
int gcd(int a, int b) {
    return b ? gcd(b, a % b) : a;
}
//lcm
int lcm(int a, int b) {
    return (a / gcd(a, b)) * b;
}
//factorial 
vector<int> factorial(int n) {
    vector<int> res(1,1);
    for(int i=2;i<=n;i++){
        int carry=0;
        for(auto &x: res){
            int prod = x*i + carry;
            x = prod % 10;
            carry = prod / 10;
        }
        while(carry){
            res.push_back(carry % 10);
            carry /= 10;
        }
    }
    reverse(res.begin(), res.end());
    return res;
}
//bigmod
int power(int a, int b, int mod) {
    int res = 1;
    a %= mod;
    while (b > 0) {
        if (b & 1) res = res * a % mod;
        a = a * a % mod;
        b >>= 1;
    }
    return res;
}

int pow(int a, int b) {
    int res = 1;
    while (b > 0) {
        if (b & 1) {        
            res *= a;       
        }
        a *= a;             
        b >>= 1;             
    }
    return res;
}
const int N = 1e6 + 5;
vector<bool> isPrime(N, true);
//prime sieve of eratosthenes
void sieve() {
    isPrime[0] = isPrime[1] = false;
    for (int i = 2; i * i < N; ++i) {
        if (isPrime[i]) {
            for (int j = i * i; j < N; j += i)
                isPrime[j] = false;
        }
    }
}

